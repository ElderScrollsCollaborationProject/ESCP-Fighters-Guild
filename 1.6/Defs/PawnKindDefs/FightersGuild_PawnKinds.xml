<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <PawnKindDef Name="ESCP_FightersGuildkindBase" Abstract="True">
        <race>Human</race>
        <defaultFactionDef>ESCP_Faction_FightersGuild</defaultFactionDef>
        <useFactionXenotypes>true</useFactionXenotypes>
        <maxGenerationAge>55</maxGenerationAge>
        <minGenerationAge>18</minGenerationAge>
        <chemicalAddictionChance>0.03</chemicalAddictionChance>
        <invNutrition>2.7</invNutrition>
        <invFoodDef>MealSurvivalPack</invFoodDef>
        <disallowedTraits>
            <li>Nudist</li>
        </disallowedTraits>
        <pawnGroupDevelopmentStage>Adult</pawnGroupDevelopmentStage>
    </PawnKindDef>

    <PawnKindDef ParentName="ESCP_FightersGuildkindBase">
        <defName>ESCP_Pawnkind_FightersGuild_Member</defName>
        <label>guild fighter</label>
        <combatPower>65</combatPower>
        <itemQuality>Normal</itemQuality>
        <gearHealthRange>0.7~1.8</gearHealthRange>
        <weaponMoney>200~500</weaponMoney>
        <weaponTags>
            <li>GoodMelee</li>
            <li>SomeMelee</li>
        </weaponTags>
        <apparelMoney>300~700</apparelMoney>
        <techHediffsMoney>50~50</techHediffsMoney>
        <techHediffsTags>
            <li>Poor</li>
        </techHediffsTags>
        <techHediffsChance>0.1</techHediffsChance>
        <initialWillRange>2~5</initialWillRange>
        <initialResistanceRange>12~20</initialResistanceRange>
        <backstoryFiltersOverride>
            <li>
                <categoriesChildhood>
                    <li>ESCP_Backstory_FightersGuild_Child</li>
                </categoriesChildhood>
                <categoriesAdulthood>
                    <li>ESCP_Backstory_FightersGuild_Fighter</li>
                </categoriesAdulthood>
            </li>
        </backstoryFiltersOverride>
    </PawnKindDef>

    <PawnKindDef ParentName="ESCP_FightersGuildkindBase">
        <defName>ESCP_Pawnkind_FightersGuild_Veteran</defName>
        <label>guild veteran</label>
        <combatPower>90</combatPower>
        <minGenerationAge>25</minGenerationAge>
        <itemQuality>Good</itemQuality>
        <gearHealthRange>0.8~2.0</gearHealthRange>
        <weaponMoney>400~900</weaponMoney>
        <weaponTags>
            <li>GoodMelee</li>
        </weaponTags>
        <apparelMoney>600~1200</apparelMoney>
        <techHediffsMoney>100~100</techHediffsMoney>
        <techHediffsTags>
            <li>Poor</li>
            <li>Middle</li>
        </techHediffsTags>
        <techHediffsChance>0.2</techHediffsChance>
        <initialWillRange>4~8</initialWillRange>
        <initialResistanceRange>18~28</initialResistanceRange>
        <backstoryFiltersOverride>
            <li>
                <categoriesChildhood>
                    <li>ESCP_Backstory_FightersGuild_Child</li>
                </categoriesChildhood>
                <categoriesAdulthood>
                    <li>ESCP_Backstory_FightersGuild_Fighter</li>
                </categoriesAdulthood>
            </li>
        </backstoryFiltersOverride>
    </PawnKindDef>

    <PawnKindDef ParentName="ESCP_FightersGuildkindBase">
        <defName>ESCP_Pawnkind_FightersGuild_Champion</defName>
        <label>guild champion</label>
        <combatPower>130</combatPower>
        <minGenerationAge>30</minGenerationAge>
        <itemQuality>Excellent</itemQuality>
        <gearHealthRange>0.9~2.5</gearHealthRange>
        <weaponMoney>700~1500</weaponMoney>
        <weaponTags>
            <li>GoodMelee</li>
        </weaponTags>
        <apparelMoney>1000~2000</apparelMoney>
        <techHediffsMoney>150~150</techHediffsMoney>
        <techHediffsTags>
            <li>Middle</li>
            <li>Rich</li>
        </techHediffsTags>
        <techHediffsChance>0.3</techHediffsChance>
        <initialWillRange>6~12</initialWillRange>
        <initialResistanceRange>24~36</initialResistanceRange>
        <backstoryFiltersOverride>
            <li>
                <categoriesChildhood>
                    <li>ESCP_Backstory_FightersGuild_Child</li>
                </categoriesChildhood>
                <categoriesAdulthood>
                    <li>ESCP_Backstory_FightersGuild_Champion</li>
                </categoriesAdulthood>
            </li>
        </backstoryFiltersOverride>
    </PawnKindDef>

    <PawnKindDef ParentName="ESCP_FightersGuildkindBase">
        <defName>ESCP_Pawnkind_FightersGuild_Quartermaster</defName>
        <label>guild quartermaster</label>
        <combatPower>50</combatPower>
        <trader>true</trader>
        <itemQuality>Normal</itemQuality>
        <gearHealthRange>0.6~1.5</gearHealthRange>
        <weaponMoney>150~400</weaponMoney>
        <weaponTags>
            <li>SomeMelee</li>
        </weaponTags>
        <apparelMoney>300~600</apparelMoney>
        <techHediffsChance>0</techHediffsChance>
        <initialWillRange>1~3</initialWillRange>
        <initialResistanceRange>8~14</initialResistanceRange>
        <backstoryFiltersOverride>
            <li>
                <categoriesChildhood>
                    <li>ESCP_Backstory_FightersGuild_Child</li>
                </categoriesChildhood>
                <categoriesAdulthood>
                    <li>ESCP_Backstory_FightersGuild_Fighter</li>
                </categoriesAdulthood>
            </li>
        </backstoryFiltersOverride>
    </PawnKindDef>

</Defs>
